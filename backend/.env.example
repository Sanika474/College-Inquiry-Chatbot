# CampusIQ Environment Configuration (Example Template)
# Copy this file to .env and configure your credentials.

PROJECT_NAME="CampusIQ — Intelligent College Companion"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# Security
SECRET_KEY="replace-with-a-secure-random-secret-key"
SESSION_COOKIE_NAME="campusiq_session"
SESSION_MAX_AGE_SECONDS=604800
COOKIE_SECURE=false
COOKIE_SAMESITE="lax"

# PostgreSQL Database Connection URL
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/campusiq_db"

# Allowed Frontend Origins (Comma-separated)
CORS_ORIGINS="http://localhost:8000,http://127.0.0.1:8000"

# Optional AI Fallback Configuration
# AI_PROVIDER options: "gemini", "openai", or leave blank for deterministic rule-engine only
AI_PROVIDER="gemini"
AI_API_KEY="your-gemini-or-openai-api-key"
AI_MODEL_NAME="gemini-1.5-flash"
AI_TIMEOUT_SECONDS=10.0
